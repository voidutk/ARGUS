{
  "name": "argus-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:reset": "node scripts/db-reset.js",
    "load-reference": "node scripts/load-reference-data.js",
    "load-reference:dry": "node scripts/load-reference-data.js --dry-run --verbose",
    "generate-alerts": "node scripts/generate-alerts.js",
    "setup": "npm run migrate && npm run seed && npm run load-reference && npm run compute-scores && npm run generate-alerts && npm run seed:evidence && npm run project-neo4j",
    "test:unit": "node --test \"test/*.test.js\"",
    "verify-determinism": "node scripts/verify-determinism.js",
    "verify-plant": "node scripts/verify-plant.js",
    "smoke": "node scripts/smoke.js",
    "smoke-v2": "node scripts/smoke-v2.js",
    "evidence-e2e": "node scripts/evidence-e2e.js",
    "verify-all": "npm run test:unit && npm run verify-determinism && npm run verify-plant && npm run smoke && npm run smoke-v2 && npm run evidence-e2e",
    "seed:evidence": "node src/db/seedEvidence.js",
    "compute-scores": "node scripts/compute-scores.js",
    "verify-extraction": "node scripts/verify-extraction.js",
    "project-neo4j": "node scripts/project-neo4j.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "pino": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
